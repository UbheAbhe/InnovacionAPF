# ==========================================
# Variables de Entorno - Microservicio Flask
# APF3 - Tiendas 3A (AJILES PERU S.A.C.)
# ==========================================

# Puerto del servicio (Render asigna $PORT automáticamente en producción)
PORT=5000

# Cadena de conexión PostgreSQL (Usa Pooler IPv4 para compatibilidad total con Render)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Credenciales Supabase API (opcional para client SDK)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=tu-anon-key-aqui
